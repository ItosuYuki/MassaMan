# Copy to .env.local and fill in real values for local development.

# Secret key used to sign session cookies (jose/HS256). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Slack Incoming Webhook URL for reservation created/cancelled + reminder
# notifications. Create one at https://api.slack.com/messaging/webhooks.
# Leave blank to disable Slack notifications (they no-op with a console warning).
SLACK_WEBHOOK_URL=
