# Copy to .env.local and fill in real values for local development.

# Secret key used to sign session cookies (jose/HS256). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# PostgreSQL connection string (see docker-compose.yml for the local credentials).
DATABASE_URL=postgresql://massaman:massaman@localhost:5432/massaman

# Slack app OAuth / Bot API integration.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=xoxb-
# Must exactly match the Redirect URL registered in Slack OAuth & Permissions.
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback
# Optional email delivery adapter.
EMAIL_WEBHOOK_URL=
NOTIFICATION_JOB_SECRET=
